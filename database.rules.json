{
  "rules": {
    ".read": true,
    ".write": false,
    "patches": {
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['gameTitle','translatorId','translatedBy','haveRom']) && newData.child('gameTitle').isString() && newData.child('translatorId').isString() && newData.child('translatedBy').isString() && newData.child('haveRom').isBoolean()"
      }
    },
    "translators": { "$id": { ".write": "auth != null && root.child('admins').child(auth.uid).exists()", ".validate": "newData.hasChildren(['shortName','name']) && newData.child('shortName').isString() && newData.child('name').isString()" } },
    "tags": { "$id": { ".write": "auth != null && root.child('admins').child(auth.uid).exists()", ".validate": "newData.hasChildren(['name']) && newData.child('name').isString()" } },
    "systems": { "$id": { ".write": "auth != null && root.child('admins').child(auth.uid).exists()", ".validate": "newData.hasChildren(['shortName','name']) && newData.child('shortName').isString() && newData.child('name').isString()" } },
    "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } }
  }
}
